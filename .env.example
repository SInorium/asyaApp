# --- api ---
DATABASE_URL=postgresql://asya:asya@localhost:5432/asya
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# invite | open
AUTHOR_REGISTRATION=invite
AUTHOR_INVITE_CODE=asya-invite
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artworks
# dev: API сам создаёт бакет с публичным чтением
S3_AUTO_CREATE_BUCKET=true
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin12345
# Публичный базовый URL изображений
S3_PUBLIC_URL=http://localhost:9000/artworks
WEB_REVALIDATE_URL=http://localhost:3000/revalidate
REVALIDATE_SECRET=change-me-revalidate
SEED_OWNER_EMAIL=owner@asya.local
SEED_OWNER_PASSWORD=owner12345

# --- web ---
# Адрес API для серверного рендеринга (RSC)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/artworks
NEXT_PUBLIC_SITE_URL=http://localhost:8080
